<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AuroraPomodoro</AssemblyName>
    <RootNamespace>AuroraPomodoro</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>AuroraPomodoro.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AuroraGlass.Wpf">
      <HintPath>../external/AuroraGlass-0.8.0/managed/WPF/Debug/AuroraGlass.Wpf.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CopyAuroraGlassRuntime" AfterTargets="Build">
    <Copy SourceFiles="../external/AuroraGlass-0.8.0/bin/Debug/AuroraGlassWpfInterop.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../external/AuroraGlass-0.8.0/shaders/background.hlsl;../external/AuroraGlass-0.8.0/shaders/blur.hlsl;../external/AuroraGlass-0.8.0/shaders/fullscreen_triangle.hlsl;../external/AuroraGlass-0.8.0/shaders/glass.hlsl"
          DestinationFolder="$(OutDir)shaders" SkipUnchangedFiles="true" />
  </Target>
</Project>
